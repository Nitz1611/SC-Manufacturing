DATABRICKS_WAREHOUSE_ID=
# Copy your workspace hostname from the Databricks URL (adb-xxxxx.azuredatabricks.net) — do NOT use a placeholder
DATABRICKS_HOST=
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_PAT_TOKEN=
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=
DATABRICKS_METRIC_VIEW=uc_dev_cgf_mdip_01.scm_gold.pgt_plnt_prodtn_metric_view

# AI tab summaries — Claude Opus 4.6 via Databricks Model Serving (default when configured)
SUMMARY_PROVIDER=claude
CLAUDE_SERVING_ENDPOINT=databricks-claude-opus-4-6
# CLAUDE_API_MODE=auto          # auto | invocations | anthropic
# CLAUDE_MAX_TOKENS=1024
# SUMMARY_ALLOW_TEMPLATE_FALLBACK=false

# Corporate network — use if terminal shows "fetch failed"
# HTTPS_PROXY=http://proxy.company.com:8080
# NODE_EXTRA_CA_CERTS=C:\path\to\corporate-root-ca.pem
SUPERVISOR_ENDPOINT_NAME=
# Uses DATABRICKS_HOST + DATABRICKS_PAT_TOKEN above
# SUPERVISOR_DEBUG=false
# Long-running agent mode — allows more Supervisor tool-call steps (max nodes)
SUPERVISOR_LONG_TASK=true
SUPERVISOR_MAX_CONTINUATIONS=12

# MEASURE() row context — default 1=1 (no Downtime Type filter).
# Do NOT filter Downtime Type before MEASURE(`Unplanned Downtime %`) or MEASURE(`Unplanned Downtime Hours`).
# DATABRICKS_MEASURE_FILTER=1=1
DATABRICKS_DATE_COLUMN=Production Date
DATABRICKS_SITE_COLUMN=Site
DATABRICKS_REGION_COLUMN=Region
# Year filter = YEAR(`Production Date`); period = P1..P13 from `Production Period`
# DATABRICKS_PERIOD_EXPR=CONCAT('P', CAST(`Production Period` AS STRING))
# DATABRICKS_WEEK_EXPR=CONCAT(CAST(YEAR(`Production Date`) AS STRING), 'P', LPAD(CAST(`Production Period` AS STRING), 2, '0'), 'W', LPAD(CAST(`Production week` AS STRING), 2, '0'))

INSIGHTS_REFRESH_INTERVAL_HOURS=24
SUMMARY_CACHE_TTL_HOURS=24
METRICS_MEMORY_CACHE_MINUTES=15
PRELOAD_ENABLED=true
PRELOAD_INTERVAL_MINUTES=15
PRELOAD_CONCURRENCY=3
PRELOAD_DEFAULT_YEAR=2026
# Set to true only for local UI development without Databricks SQL
CONSOLE_DEMO_MODE=false
PORT=8000
