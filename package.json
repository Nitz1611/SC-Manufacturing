{
  "name": "sc-manufacturing-console",
  "private": true,
  "version": "2.0.0",
  "description": "SC Manufacturing Console — React + Node + direct SQL analytics",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "build:deploy": "npm run build && bash scripts/build-deploy-bundle.sh",
    "build:deploy:python": "bash scripts/build-python-deploy-bundle.sh",
    "test:deploy": "bash scripts/test-databricks-build.sh",
    "test:deploy:python": "bash scripts/test-python-deploy.sh",
    "start": "npm run start --workspace=server"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
