# ── Databricks SQL (KPI tiles + filter dropdowns) ───────────────────
# NO spaces after = signs.
DATABRICKS_SERVER_HOSTNAME=adb-xxxxx.azuredatabricks.net
DATABRICKS_HOST=adb-xxxxx.azuredatabricks.net
DATABRICKS_PAT_TOKEN=your-token

# Use either warehouse id OR full HTTP path (both work)
DATABRICKS_WAREHOUSE_ID=your-warehouse-id
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id

DATABRICKS_CATALOG=uc_dev_cgf_mdip_01
DATABRICKS_SCHEMA=scm_gold

# ── MAS Supervisor (AI insights, alerts, RCA) ───────────────────────
SUPERVISOR_ENDPOINT_NAME=your-supervisor-endpoint
SUPERVISOR_QUERY_MODE=minimal
SUPERVISOR_MAX_WORKERS=8
SUPERVISOR_QUESTION_TIMEOUT=600

# Optional: bypass Supervisor and call Claude directly
# USE_CLAUDE_DIRECT=false
# CLAUDE_SERVING_ENDPOINT=databricks-claude-opus-4-6

# ── App / cache ─────────────────────────────────────────────────────
DATABRICKS_APP_PORT=8000
GENIE_INSIGHTS_ON_STARTUP=true
INSIGHTS_REFRESH_INTERVAL_HOURS=24
INSIGHTS_REFRESH_INTERVAL_MINUTES=30
