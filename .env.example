# ── Databricks SQL (required for KPI dashboard) ─────────────────────
# NO spaces after = signs. NO backticks on the full metric view path.
DATABRICKS_SERVER_HOSTNAME=adb-xxxxx.azuredatabricks.net
DATABRICKS_HOST=adb-xxxxx.azuredatabricks.net
DATABRICKS_PAT_TOKEN=your-token
DATABRICKS_WAREHOUSE_ID=your-warehouse-id
DATABRICKS_CATALOG=uc_dev_cgf_mdip_01
DATABRICKS_SCHEMA=scm_gold
DATABRICKS_METRIC_VIEW=uc_dev_cgf_mdip_01.scm_gold.pgt_plnt_prodtn_metric_view

# Column with spaces — backticks OK here only
DATABRICKS_DATE_COLUMN=Production Date

# ── AI tab summaries (optional — not used for chart numbers) ───────
SUMMARY_PROVIDER=claude
CLAUDE_SERVING_ENDPOINT=databricks-claude-sonnet-5

# ── App ───────────────────────────────────────────────────────────
PORT=8000
CONSOLE_DEMO_MODE=false
PRELOAD_ENABLED=true
SQL_MAX_CONCURRENCY=4
METRICS_MEMORY_CACHE_MINUTES=30
MAINTENANCE_PAYLOAD_TTL_MINUTES=15

# ── Not used by Flask DT dashboard (Sravani/Supervisor legacy) ─────
# SUPERVISOR_ENDPOINT_NAME=
# SUPERVISOR_QUERY_MODE=
# GENIE_INSIGHTS_ON_STARTUP=
