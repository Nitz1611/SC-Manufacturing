# Databricks workspace
DATABRICKS_SERVER_HOSTNAME=adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_PAT_TOKEN=
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id

# Optional catalog/schema for views.py SQL
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# Supervisor Model Serving (Insights / RCA / Ask Genie)
SUPERVISOR_ENDPOINT_NAME=your-supervisor-endpoint
USE_CLAUDE_DIRECT=false

# KPI direct-SQL engine (py_server — same vars as React branch)
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_HOST=
DATABRICKS_METRIC_VIEW=catalog.schema.pgt_plnt_prodtn_metric_view
SUMMARY_PROVIDER=claude
CLAUDE_SERVING_ENDPOINT=databricks-claude-opus-4-6

# App
PORT=8000
DATABRICKS_APP_PORT=8000

# Cache & startup
INSIGHTS_REFRESH_INTERVAL_HOURS=24
INSIGHTS_REFRESH_INTERVAL_MINUTES=30
GENIE_INSIGHTS_ON_STARTUP=true
SUPERVISOR_QUERY_MODE=minimal
