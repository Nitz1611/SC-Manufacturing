# Databricks connection
DATABRICKS_HOST=adb-xxxxx.azuredatabricks.net
DATABRICKS_SERVER_HOSTNAME=adb-xxxxx.azuredatabricks.net
DATABRICKS_PAT_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# AI provider — claude (default) uses Databricks Opus; supervisor restores legacy Genie agent
AI_PROVIDER=claude
CLAUDE_SERVING_ENDPOINT=databricks-claude-opus-4-6
# CLAUDE_API_MODE=auto
# CLAUDE_MAX_TOKENS=800

# Legacy Supervisor Agent (only when AI_PROVIDER=supervisor)
# SUPERVISOR_ENDPOINT_NAME=

# Metric views (catalog.schema.table or table name if default schema)
PRODTN_VIEW=pgt_plnt_prodtn_metric_view
WASTE_VIEW=pgt_waste_pct_composite_metric_view
EVENT_VIEW=pgt_plnt_prodtn_evnt_metric_view
EFFICIENCY_VIEW=pgt_plnt_effcncy_metric_view

# Query mode: minimal | full | parallel | split
SUPERVISOR_QUERY_MODE=parallel

DATABRICKS_APP_PORT=8000
INSIGHTS_REFRESH_INTERVAL_HOURS=24
GENIE_INSIGHTS_ON_STARTUP=true
